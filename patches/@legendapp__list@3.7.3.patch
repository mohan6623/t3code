--- a/react.js
+++ b/react.js
@@ -7444,7 +7444,10 @@ var ListComponentScrollView = React3.forwardRef(function ListComponentScrollView
     const setWheelPassive = (passive) => {
       if (passive === wheelPassive) return;
       if (wheelPassive !== void 0) target.removeEventListener("wheel", onWheel);
-      target.addEventListener("wheel", onWheel, { passive });
+      // Fork: always passive. A blocking wheel listener makes every wheel notch wait for the main
+      // thread, so a reversed scroll lands late while an agent streams. onWheel already handles
+      // non-cancelable events: it stops its own animation and lets the browser apply the wheel.
+      target.addEventListener("wheel", onWheel, { passive: true });
       wheelPassive = passive;
     };
     target.addEventListener("wheel", captureWheel, { capture: true, passive: true });
